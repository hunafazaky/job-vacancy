# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=job_vacancy_db
DATABASE_URL=postgresql+asyncpg://app:changeme@db:5432/job_vacancy_db

# Auth
JWT_SECRET=changeme-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vision LLM (free tier — primary + fallback)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Upload limits
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Rate limits
ANON_DAILY_LIMIT=3
USER_DAILY_LIMIT=5

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=job-vacancy-images
R2_PUBLIC_BASE_URL=
